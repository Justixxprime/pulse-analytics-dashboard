{
  "name": "Pulse — Analytics Dashboard",
  "short_name": "Pulse",
  "description": "Pulse is an analytics dashboard UI: animated charts, instant search, and a sidebar that doesn't get in your way.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
